<mujoco model="f1_sim2sim">
  <!-- Robot kinematics, inertias, meshes, simplified collisions, and pelvis IMU. -->
  <include file="f1_1.xml"/>

  <option timestep="0.001" iterations="100" solver="Newton" gravity="0 0 -9.81">
    <flag frictionloss="enable"/>
  </option>
  <size njmax="5000" nconmax="1000"/>

  <visual>
    <quality shadowsize="4096"/>
    <map znear="0.001" zfar="50"/>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.15 0.15 0.15" specular="0.4 0.4 0.4"/>
    <global azimuth="135" elevation="-20" offwidth="1920" offheight="1080"/>
  </visual>
  <statistic center="0 0 0.9" extent="4"/>

  <!-- Torque actuators follow the native MJCF joint order.  PD control is in Python. -->
  <actuator>
    <motor name="left_hip_pitch" joint="left_hip_pitch_joint" ctrlrange="-75 75"/>
    <motor name="left_hip_roll" joint="left_hip_roll_joint" ctrlrange="-75 75"/>
    <motor name="left_hip_yaw" joint="left_hip_yaw_joint" ctrlrange="-75 75"/>
    <motor name="left_knee" joint="left_knee_joint" ctrlrange="-75 75"/>
    <motor name="left_ankle_pitch" joint="left_ankle_pitch_joint" ctrlrange="-75 75"/>
    <motor name="left_ankle_roll" joint="left_ankle_roll_joint" ctrlrange="-75 75"/>

    <motor name="right_hip_pitch" joint="right_hip_pitch_joint" ctrlrange="-75 75"/>
    <motor name="right_hip_roll" joint="right_hip_roll_joint" ctrlrange="-75 75"/>
    <motor name="right_hip_yaw" joint="right_hip_yaw_joint" ctrlrange="-75 75"/>
    <motor name="right_knee" joint="right_knee_joint" ctrlrange="-75 75"/>
    <motor name="right_ankle_pitch" joint="right_ankle_pitch_joint" ctrlrange="-75 75"/>
    <motor name="right_ankle_roll" joint="right_ankle_roll_joint" ctrlrange="-75 75"/>

    <motor name="waist_yaw" joint="waist_yaw_joint" ctrlrange="-50 50"/>
    <motor name="waist_roll" joint="waist_roll_joint" ctrlrange="-50 50"/>

    <motor name="left_shoulder_pitch" joint="left_shoulder_pitch_joint" ctrlrange="-25 25"/>
    <motor name="left_shoulder_roll" joint="left_shoulder_roll_joint" ctrlrange="-25 25"/>
    <motor name="left_shoulder_yaw" joint="left_shoulder_yaw_joint" ctrlrange="-25 25"/>
    <motor name="left_elbow" joint="left_elbow_joint" ctrlrange="-25 25"/>
    <motor name="left_wrist_roll" joint="left_wrist_roll_joint" ctrlrange="-25 25"/>
    <motor name="left_wrist_yaw" joint="left_wrist_yaw_joint" ctrlrange="-5 5"/>
    <motor name="left_wrist_pitch" joint="left_wrist_pitch_joint" ctrlrange="-5 5"/>

    <motor name="right_shoulder_pitch" joint="right_shoulder_pitch_joint" ctrlrange="-25 25"/>
    <motor name="right_shoulder_roll" joint="right_shoulder_roll_joint" ctrlrange="-25 25"/>
    <motor name="right_shoulder_yaw" joint="right_shoulder_yaw_joint" ctrlrange="-25 25"/>
    <motor name="right_elbow" joint="right_elbow_joint" ctrlrange="-25 25"/>
    <motor name="right_wrist_roll" joint="right_wrist_roll_joint" ctrlrange="-25 25"/>
    <motor name="right_wrist_yaw" joint="right_wrist_yaw_joint" ctrlrange="-5 5"/>
    <motor name="right_wrist_pitch" joint="right_wrist_pitch_joint" ctrlrange="-5 5"/>
  </actuator>

  <keyframe>
    <!-- free joint (7) followed by the 28 native-MJCF-order joint positions -->
    <key name="home" qpos="0 0 0.9 1 0 0 0  -0.1 0 0 0.2 -0.1 0  -0.1 0 0 0.2 -0.1 0  0 0  0 0 0 1.4 0 0 0  0 0 0 1.4 0 0 0"/>
  </keyframe>
</mujoco>
